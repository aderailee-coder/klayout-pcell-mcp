<?xml version="1.0" encoding="utf-8"?>
<technology>
  <name>MyProcess</name>
  <description>Laker Technology File converted for KLayout</description>
  <group></group>
  <dbu>0.001</dbu>
  <base-path>$(appdata_path)/tech/MyProcess</base-path>
  <original-base-path>$(appdata_path)/tech/MyProcess</original-base-path>
  <layer-properties_file>MyProcess.lyp</layer-properties_file>
  <add-other-layers>true</add-other-layers>
  <reader-options>
    <gds2>
      <layer-map></layer-map>
      <create-other-layers>true</create-other-layers>
    </gds2>
  </reader-options>
  <connectivity>
    <!--
    Connectivity rules are normally edited through the GUI
    (Tools → Manage Technologies → Connectivity).
    Use the connectivity.txt generated by translate_laker_tf as reference.

    Example (manual entry in GUI):
      Conductor: 10/0
      Via:       20/0
      Conductor: 11/0
    -->
  </connectivity>
</technology>
